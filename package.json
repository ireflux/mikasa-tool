{
  "name": "mikasa-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node --max_old_space_size=8192 node_modules/vite/bin/vite.js build --mode production && node --max_old_space_size=8192 node_modules/vite/bin/vite.js build --mode production --ssr src/entry-server.ts && node --max_old_space_size=4096 scripts/prerender.mjs",
    "build:dev": "vue-tsc --noEmit && node --max_old_space_size=8192 node_modules/vite/bin/vite.js build --mode development && node --max_old_space_size=8192 node_modules/vite/bin/vite.js build --mode development --ssr src/entry-server.ts && node --max_old_space_size=4096 scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint src --fix",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.2",
