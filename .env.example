# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 部署基路径（GitHub Pages 项目页面需设置为 /repo-name/，默认 /）
VITE_BASE_URL = '/'
# 网站名称
VITE_APP_TITLE = 'Mikasa-Tool'
# 简短描述
VITE_APP_DESC = '天寒渐觉雁声疏，新月微微玉漏初'
# base api
VITE_APP_BASE_API = '/v1'
# 服务端地址: https://xxx.xxx.com; 留空则为纯前端部署
VITE_SERVE = ''
# 自定义启动host
VITE_HOST = '127.0.0.1'
# 第三方反馈互动地址
VITE_FEEDBACK_URL = ''
# 网站绝对地址（用于生成 canonical/og:url，无域名时留空）
VITE_SITE_URL = ''
# 左侧底部广告位
VITE_LEFT_ADV = ''