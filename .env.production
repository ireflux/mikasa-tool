# 生产环境配置
# 部署基路径（GitHub Actions 中会通过 env 覆盖为 /repo-name/）
VITE_BASE_URL = '/'
# 网站名称
VITE_APP_TITLE = 'Mikasa Tool'
# 简短描述
VITE_APP_DESC = '天寒渐觉雁声疏，新月微微玉漏初'
# base api
VITE_APP_BASE_API = '/v1'
# 服务端地址（留空则为纯前端部署）
VITE_SERVE = ''
# 第三方反馈互动地址
VITE_FEEDBACK_URL = ''
# 网站绝对地址（用于生成 canonical/og:url，无域名时留空）
VITE_SITE_URL = ''
# 左侧底部广告位
VITE_LEFT_ADV = ''
