# 生产环境配置
# 部署基路径（GitHub Actions 中会通过 env 覆盖为 /repo-name/）
VITE_BASE_URL = '/'
# 网站名称
VITE_APP_TITLE = 'Mikasa Tool'
# 简短描述
VITE_APP_DESC = '天寒渐觉雁声疏，新月微微玉漏初'
# base api
VITE_APP_BASE_API = '/v1'
# 服务端地址
VITE_SERVE = ''
# 第三方反馈互动地址
VITE_FEEDBACK_URL = ''
# 广告位开关(废弃)
VITE_ADV_SHOW = 'false'
# 左侧底部广告位
VITE_LEFT_ADV = ''
# 是否启用Mock数据('true'启用, 'false'不启用)
VITE_IS_MOCK = 'false'
